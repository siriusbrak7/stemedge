{
  "name": "stemedge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive STEM Learning Platform with Virtual Labs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:win": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "preview:prod": "vite preview --port=4000",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:full": "node -e \"const fs=require('fs'); ['node_modules','dist','package-lock.json'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}))\"",
    "reinstall": "npm run clean:full && npm install",
    "reinstall:win": "npm run clean:full && npm install --platform=win32",
    "rebuild": "npm rebuild",
    "rebuild:win": "npm rebuild --platform=win32 --arch=x64",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run dev"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
