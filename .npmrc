# StemEdge - NPM Configuration
# ============================================
# This file helps resolve native module platform issues when developing
# on Windows with WSL (Windows Subsystem for Linux)
#
# PROBLEM: When running npm install from WSL while the project is on the
# Windows filesystem (/mnt/c/Users/...), npm may install Linux binaries
# instead of Windows binaries, causing errors like:
# "Cannot find module 'lightningcss.win32-x64-msvc.node'"
#
# SOLUTION: This configuration helps npm detect the correct platform.
#
# IMPORTANT: If developing in WSL, consider moving the project to the
# Linux filesystem (~/StemEdge) instead of Windows filesystem.

# If you're developing on Windows (recommended for this project):
# Comment out the lines below if developing natively in WSL
# platform=win32
# arch=x64

# For cross-platform development, let npm auto-detect
# but be aware of the WSL + Windows filesystem issue

# Optional: Specify registry (uncomment if needed)
# registry=https://registry.npmjs.org/

# Reduce package lock conflicts
package-lock=true

# Prefer offline for faster installs
prefer-offline=true
