# Supabase client configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Optional AI proxy for remote grading and tutor features.
# Leave unset to use the built-in deterministic fallbacks.
VITE_AI_PROXY_URL="http://localhost:8787"

# Set to "true" to bypass Supabase auth and use a mock user for local development.
# Never enable in production.
VITE_MOCK_AUTH="false"
